{
  "name": "ottopersona-ai-workspace",
  "version": "1.0.0",
  "description": "OttoPersona AI — Context-Aware Communication Assistant",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix backend test",
    "start": "npm --prefix backend start",
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "frontend:dev": "npm --prefix frontend run dev",
    "backend:dev": "npm --prefix backend run dev"
  }
}
